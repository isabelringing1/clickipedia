# Public address of the published Wikipedia link graph (the R2 bucket's custom
# domain). The game reads latest.json and snapshots/<id>/... below this URL.
#
# Copy this file to .env.development.local and .env.production.local (both are
# gitignored) and set the value for each:
#
#   development   http://localhost:8787/   served by `npm run graph:serve`
#   production    the bucket's custom domain, e.g. https://graph.example.com/
#
# This is a public URL, not a credential. Every VITE_ variable is compiled
# into the JavaScript sent to players, so never put R2 or Cloudflare
# credentials in one. Publishing uses `wrangler login` on your own machine.
VITE_WIKI_GRAPH_BASE_URL=http://localhost:8787/
