{
  "name": "clickipedia",
  "private": true,
  "version": "0.0.0",
  "homepage": "https://isabisabel.com/clickipedia/",
  "type": "module",
  "scripts": {
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "graph": "cargo run --release --quiet --manifest-path tools/wiki-graph/Cargo.toml --",
    "graph:test": "cargo test --manifest-path tools/wiki-graph/Cargo.toml",
    "graph:serve": "node tools/wiki-graph/scripts/serve.mjs",
    "graph:publish": "node tools/wiki-graph/scripts/publish.mjs",
    "graph:verify-public": "node tools/wiki-graph/scripts/verify-public.mjs",
    "graph:promote": "node tools/wiki-graph/scripts/promote.mjs"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-resizable": "^3.0.5",
    "spinners-react": "^1.0.11",
    "use-sound": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "fake-indexeddb": "^6.2.8",
    "gh-pages": "^6.3.0",
    "globals": "^16.4.0",
    "vite": "^7.1.7",
    "vitest": "^5.1.0",
    "wrangler": "^4.159.0"
  }
}
